# Environment variables for LCD Hostname/IP Display
# Copy this file to .env and adjust values as needed

# I2C address of LCD (hexadecimal or decimal)
LCD_I2C_ADDR=0x3F

# Raspberry Pi revision (1 for Pi 1, 2 for Pi 2/3/4)
LCD_PI_REV=2

# Enable LCD backlight (true/false)
LCD_BACKLIGHT=true

# Update interval in seconds
UPDATE_INTERVAL=60