# Tailscale Configuration
# Get your auth key from: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxx

# Optional: Custom hostname for Tailscale device
# TS_HOSTNAME=laser-cnc-raspberrypi

# Optional: Additional Tailscale arguments
# TS_EXTRA_ARGS=--advertise-exit-node --advertise-tags=tag:laser-cnc

# Docker Compose Project Name (optional)
COMPOSE_PROJECT_NAME=lasercnc